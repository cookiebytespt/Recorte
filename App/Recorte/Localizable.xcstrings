            "state" : "translated",
            "value" : "Crée une copie de la sélection (⌘D)."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faz uma cópia da seleção (⌘D)."
          }
        }
      }
    },
    "Makes a cut line around the printed images, a small distance away from them (⇧⌘K)." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea una línea de corte alrededor de las imágenes impresas, a una pequeña distancia (⇧⌘K)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crée une ligne de découpe autour des images imprimées, à une petite distance (⇧⌘K)."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faz uma linha de corte à volta das imagens impressas, a uma pequena distância (⇧⌘K)."
          }
        }
      }
    },
    "Makes a cut line around this image, a small distance away from it (⇧⌘K)." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea una línea de corte alrededor de esta imagen, a una pequeña distancia (⇧⌘K)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crée une ligne de découpe autour de cette image, à une petite distance (⇧⌘K)."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faz uma linha de corte à volta desta imagem, a uma pequena distância (⇧⌘K)."
          }
        }
      }
    },
    "Makes each line its own object, to move, hide or delete them one by one." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Convierte cada línea en un objeto propio, para moverlas, ocultarlas o eliminarlas una a una."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fait de chaque ligne un objet distinct, pour les déplacer, masquer ou supprimer une par une."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faz de cada linha um objeto próprio, para as mover, ocultar ou apagar uma a uma."
          }
        }
      }
    },
    "Makes the canvas as wide as the machine can cut." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hace el lienzo tan ancho como la máquina puede cortar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rend la zone de travail aussi large que la machine peut découper."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Põe a tela tão larga quanto a máquina consegue cortar."
          }
        }
      }
    },
    "Makes the image as big as the printable area allows, keeping its proportions, and centres it." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agranda la imagen tanto como permite la zona imprimible, manteniendo sus proporciones, y la centra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agrandit l’image autant que la zone imprimable le permet, en gardant ses proportions, et la centre."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aumenta a imagem tanto quanto a área de impressão permite, mantendo as proporções, e centra-a."
          }
        }
      }
    },
