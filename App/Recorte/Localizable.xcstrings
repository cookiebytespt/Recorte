    "Around the artwork" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alrededor de la ilustración"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autour de l’illustration"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À volta da arte"
          }
        }
      }
    },
    "Around the artwork uses less paper and vinyl. At the page edges keeps the marks in the same place on every sheet." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alrededor de la ilustración gasta menos papel y vinilo. En los bordes de la página mantiene las marcas en el mismo sitio en todas las hojas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autour de l’illustration utilise moins de papier et de vinyle. Aux bords de la page garde les repères au même endroit sur chaque feuille."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À volta da arte gasta menos papel e vinil. Nas margens da página mantém as marcas no mesmo sítio em todas as folhas."
          }
        }
      }
    },
    "Around the artwork: the marks sit beside the artwork (20.5 mm by default, like SignMaster), which uses less paper and vinyl. At the page edges: the marks stay in the corners of the page, wherever the artwork is." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alrededor de la ilustración: las marcas quedan al lado de la ilustración (20,5 mm por defecto, como en SignMaster), lo que gasta menos papel y vinilo. En los bordes de la página: las marcas quedan en las esquinas de la página, esté donde esté la ilustración."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autour de l’illustration : les repères sont placés à côté de l’illustration (20,5 mm par défaut, comme SignMaster), ce qui utilise moins de papier et de vinyle. Aux bords de la page : les repères restent dans les coins de la page, où que soit l’illustration."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À volta da arte: as marcas ficam ao lado da arte (20,5 mm por omissão, como no SignMaster), o que gasta menos papel e vinil. Nas margens da página: as marcas ficam nos cantos da página, esteja a arte onde estiver."
          }
        }
      }
    },
