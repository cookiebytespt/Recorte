    "W" : {},
    "Watch the head: it visits the four marks, then cuts. If it stops or beeps before cutting, it didn't find the marks." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Observe el cabezal: pasa por las cuatro marcas y después corta. Si se detiene o pita antes de cortar, no ha encontrado las marcas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Observez la tête : elle passe sur les quatre repères, puis découpe. Si elle s’arrête ou bipe avant de découper, elle n’a pas trouvé les repères."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Observe a cabeça: passa pelas quatro marcas e depois corta. Se parar ou apitar antes de cortar, não encontrou as marcas."
          }
        }
      }
    },
