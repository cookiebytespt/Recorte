    },
    "The machine visits the four marks, then cuts. Keep your hands clear while it moves." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La máquina pasa por las cuatro marcas y después corta. Mantenga las manos alejadas mientras se mueve."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La machine passe sur les quatre repères, puis découpe. Gardez les mains à l’écart pendant qu’elle bouge."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A máquina passa pelas quatro marcas e depois corta. Mantenha as mãos afastadas enquanto se move."
          }
        }
      }
    },
    "The machine will finish on its own." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La máquina terminará sola."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La machine terminera toute seule."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A máquina termina sozinha."
          }
        }
      }
    },
    "The mark size set on the machine. New Print & Cut projects start with it." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El tamaño de marca configurado en la máquina. Los nuevos proyectos de Imprimir y cortar empiezan con él."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La taille de repère réglée sur la machine. Les nouveaux projets d’impression et découpe l’utilisent au départ."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O tamanho de marca definido na máquina. Os novos projetos de Imprimir e Cortar começam com ele."
          }
        }
      }
    },
    "The marks don't fit on the page" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las marcas no caben en la página"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les repères ne tiennent pas sur la page"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As marcas não cabem na página"
          }
        }
      }
    },
    "The name shown in the layers list." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El nombre que aparece en la lista de capas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le nom affiché dans la liste des calques."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O nome que aparece na lista de camadas."
          }
        }
      }
    },
    "The printer queue that sends jobs to the machine. Recorte names it Recorte_Liyu when it sets the machine up." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cola de impresión que envía los trabajos a la máquina. Recorte la llama Recorte_Liyu cuando configura la máquina."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La file d’impression qui envoie les travaux à la machine. Recorte la nomme Recorte_Liyu quand il configure la machine."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A fila de impressão que envia os trabalhos para a máquina. O Recorte chama-lhe Recorte_Liyu quando configura a máquina."
          }
        }
      }
    },
    "The serial port the machine is connected to." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El puerto serie al que está conectada la máquina."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le port série auquel la machine est connectée."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A porta série onde a máquina está ligada."
          }
        }
      }
    },
    "The sheet is already printed" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La hoja ya está impresa"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La feuille est déjà imprimée"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A folha já está impressa"
          }
        }
      }
    },
    "The starting value for new Output sessions. You can still change it for each job." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El valor inicial en la ventana Salida. Puede seguir cambiándolo en cada trabajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La valeur de départ dans la fenêtre Sortie. Vous pouvez toujours la changer pour chaque travail."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O valor inicial na janela Saída. Pode continuar a mudá-lo em cada trabalho."
          }
        }
      }
    },
    "The tip of a drag knife trails a little behind the centre of the holder, which would round off the corners. Recorte adds a small loop at each corner to turn the blade. Overcut carries the cut a little past the start, so closed shapes come out cleanly. Find the right values with a test cut." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La punta de una cuchilla de arrastre queda un poco detrás del centro del portacuchillas, lo que redondearía las esquinas. Recorte añade un pequeño bucle en cada esquina para girar la cuchilla. El sobrecorte prolonga el corte un poco más allá del inicio, para que las formas cerradas salgan limpias. Encuentre los valores adecuados con un corte de prueba."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La pointe d’une lame traînante se trouve un peu derrière le centre du porte-lame, ce qui arrondirait les angles. Recorte ajoute une petite boucle à chaque angle pour faire pivoter la lame. La surcoupe prolonge la découpe un peu après le début, pour que les formes fermées soient nettes. Trouvez les bonnes valeurs avec une découpe test."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A ponta de uma lâmina arrastada fica um pouco atrás do centro do suporte, o que arredondaria os cantos. O Recorte acrescenta um pequeno laço em cada canto para rodar a lâmina. O sobrecorte prolonga o corte um pouco para lá do início, para as formas fechadas saírem limpas. Encontre os valores certos com um corte de teste."
          }
        }
      }
    },
    "The tips and the Getting Started window come back the next time you open Recorte." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los consejos y la ventana Primeros pasos volverán a aparecer la próxima vez que abra Recorte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les conseils et la fenêtre Prise en main reviendront à la prochaine ouverture de Recorte."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As dicas e a janela Primeiros passos voltam a aparecer da próxima vez que abrir o Recorte."
          }
        }
      }
    },
    "The widest the machine can cut. Recorte warns when a design is wider." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El ancho máximo que la máquina puede cortar. Recorte avisa cuando un diseño es más ancho."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La plus grande largeur que la machine peut découper. Recorte prévient quand un motif est plus large."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A maior largura que a máquina consegue cortar. O Recorte avisa quando um desenho é mais largo."
          }
        }
      }
    },
    "There are no cut lines yet" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todavía no hay líneas de corte"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il n’y a pas encore de lignes de découpe"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ainda não há linhas de corte"
          }
        }
      }
    },
    "Tips will show again" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los consejos volverán a aparecer"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les conseils s’afficheront à nouveau"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As dicas vão voltar a aparecer"
          }
        }
      }
    },
    "To cut the same design again, load another printed sheet and choose Cut another copy. Recorte sends the same job." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para volver a cortar el mismo diseño, cargue otra hoja impresa y elija Cortar otra copia. Recorte envía el mismo trabajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour découper à nouveau le même motif, chargez une autre feuille imprimée et choisissez Découper une autre copie. Recorte envoie le même travail."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para cortar o mesmo desenho de novo, coloque outra folha impressa e escolha Cortar outra cópia. O Recorte envia o mesmo trabalho."
          }
        }
      }
    },
    "To print on another computer" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para imprimir en otro ordenador"
          }
        },
