    "The machine is connected but Recorte needs to set it up once. Use Set up the machine above." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La máquina está conectada, pero Recorte debe configurarla una vez. Use Configurar la máquina, arriba."
          }
        },
        "fr" : {
          "stringUnit" : {
