    },
    "Off (default): the machine uses the speed and pressure set on its panel. On: each job sends the values chosen in Output, like SignMaster with Cutting Speed and Cutting Force ticked." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactivado (predeterminado): la máquina usa la velocidad y la presión ajustadas en su panel. Activado: cada trabajo envía los valores elegidos en Salida, como SignMaster con Cutting Speed y Cutting Force marcados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactivé (par défaut) : la machine utilise la vitesse et la pression réglées sur son panneau. Activé : chaque travail envoie les valeurs choisies dans Sortie, comme SignMaster avec Cutting Speed et Cutting Force cochés."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desligado (predefinição): a máquina usa a velocidade e a pressão definidas no painel. Ligado: cada trabalho envia os valores escolhidos em Saída, como o SignMaster com Cutting Speed e Cutting Force assinalados."
          }
        }
      }
    },
    "Off: only white that touches the edge of the image is background." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactivado: solo el blanco que toca el borde de la imagen es fondo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactivé : seul le blanc qui touche le bord de l’image est considéré comme fond."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desligado: só o branco que toca na margem da imagem é fundo."
          }
        }
      }
    },
    "Off: the blade goes back to where it started. In SignMaster: Advance After Plot." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactivado: la cuchilla vuelve a donde empezó. En SignMaster: Advance After Plot."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactivé : la lame revient à son point de départ. Dans SignMaster : Advance After Plot."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desligado: a lâmina volta ao ponto onde começou. No SignMaster: Advance After Plot."
          }
        }
      }
    },
    "Off: the machine uses the speed and pressure set on its panel. On: Recorte sends the values below with each job. In SignMaster: Cutting Speed / Cutting Force ticked." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactivado: la máquina usa la velocidad y la presión configuradas en su panel. Activado: Recorte envía los valores de abajo con cada trabajo. En SignMaster: Cutting Speed / Cutting Force marcados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactivé : la machine utilise la vitesse et la pression réglées sur son panneau. Activé : Recorte envoie les valeurs ci-dessous avec chaque travail. Dans SignMaster : Cutting Speed / Cutting Force cochés."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desligado: a máquina usa a velocidade e a pressão definidas no painel. Ligado: o Recorte envia os valores abaixo com cada trabalho. No SignMaster: Cutting Speed / Cutting Force assinalados."
          }
        }
      }
    },
