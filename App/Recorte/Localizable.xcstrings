    "Draw shapes and write text on the canvas, import cut lines (SVG, PDF, Illustrator, DXF), or place artwork to print." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dibuje formas y escriba texto en el lienzo, importe líneas de corte (SVG, PDF, Illustrator, DXF) o coloque una ilustración para imprimir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dessinez des formes et écrivez du texte sur la zone de travail, importez des lignes de découpe (SVG, PDF, Illustrator, DXF) ou placez une illustration à imprimer."
          }
        },
        "pt" : {
