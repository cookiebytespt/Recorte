      }
    },
    "Click to add text in any installed font. It is turned into outlines for cutting." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haga clic para añadir texto en cualquier tipo de letra instalado. Se convierte en contornos para cortar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
