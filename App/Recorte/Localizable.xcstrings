    "Click a line to select it · drag points, handles or lines · ⌥-click the line to add a point · ⌥-drag a point to pull out curve handles · double-click a point for smooth/corner · ⌫ deletes" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz clic en una línea para seleccionarla · arrastra puntos, manejadores o líneas · ⌥-clic en la línea para añadir un punto · ⌥-arrastra un punto para sacar manejadores de curva · doble clic en un punto para suave/esquina · ⌫ borra"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cliquez sur une ligne pour la sélectionner · faites glisser des points, des poignées ou des lignes · ⌥-clic sur la ligne pour ajouter un point · ⌥-glisser un point pour tirer des poignées de courbe · double-clic sur un point pour lisse/angle · ⌫ supprime"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clique numa linha para a selecionar · arraste pontos, alças ou linhas · ⌥-clique na linha para adicionar um ponto · ⌥-arraste um ponto para puxar alças de curva · duplo clique num ponto para suave/canto · ⌫ apaga"
          }
        }
      }
    },
    "Click the background and drag to take more similar colours" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz clic en el fondo y arrastra para tomar más colores parecidos"
          }
