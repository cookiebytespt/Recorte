          "stringUnit" : {
            "state" : "translated",
            "value" : "Vitesse et pression de la machine · %@"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velocidade e pressão da própria máquina · %@"
          }
        }
      }
    },
    "Make a cut line around the printed images, or draw one." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cree una línea de corte alrededor de las imágenes impresas o dibuje una."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Créez une ligne de découpe autour des images imprimées, ou dessinez-en une."
