    "Locked objects can't be moved, resized or deleted. They are still printed and cut." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los objetos bloqueados no se pueden mover, redimensionar ni eliminar. Se siguen imprimiendo y cortando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
