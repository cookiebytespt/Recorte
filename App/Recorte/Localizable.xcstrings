    "Round corners are easier to weed and to cut. Sharp keeps the corners of angular artwork." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las esquinas redondas son más fáciles de cortar y de pelar. Vivas mantiene las esquinas de ilustraciones angulosas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les angles arrondis sont plus faciles à découper et à écheniller. Vifs garde les angles des illustrations anguleuses."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os cantos redondos são mais fáceis de cortar e de descascar. Vivos mantém os cantos de artes angulosas."
