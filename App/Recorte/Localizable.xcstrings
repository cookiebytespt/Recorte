          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Illustrator et la plupart des applications de design exportent à 72. Si un SVG s’ouvre trop grand ou trop petit, essayez l’autre option."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
