        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afaste a arte das margens, use uma página maior ou uma distância menor."
          }
        }
      }
    },
    "Move the blade to **the front right corner of the vinyl**, where the cut starts." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lleve la cuchilla a **la esquina delantera derecha del vinilo**, donde empieza el corte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Placez la lame sur **le coin avant droit du vinyle**, là où la découpe commence."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leve a lâmina até **ao canto da frente, à direita, do vinil**, onde o corte começa."
          }
        }
      }
    },
    "Move the shapes that cross the marks, or place the marks around the artwork." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mueva las formas que cruzan las marcas o coloque las marcas alrededor de la ilustración."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déplacez les formes qui croisent les repères, ou placez les repères autour de l’illustration."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mova as formas que passam pelas marcas ou coloque as marcas à volta da arte."
          }
        }
      }
    },
    "Move, add or remove the points of the lines. You can also double-click the object on the canvas." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mover, añadir o eliminar los puntos de las líneas. También puede hacer doble clic en el objeto en el lienzo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déplacer, ajouter ou supprimer les points des lignes. Vous pouvez aussi double-cliquer sur l’objet dans la zone de travail."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mover, adicionar ou apagar os pontos das linhas. Também pode fazer duplo clique no objeto na tela."
          }
        }
      }
    },
    "Moves the lines outwards (positive) or inwards (negative) by this distance." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
