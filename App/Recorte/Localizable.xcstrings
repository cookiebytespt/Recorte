        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crie uma linha de corte à volta das imagens impressas ou desenhe uma."
          }
        }
      }
    },
    "Make the design smaller, rotate it, or move it closer to the right." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reduzca el diseño, gírelo o acérquelo a la derecha."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réduisez le motif, faites-le pivoter ou rapprochez-le de la droite."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reduza o desenho, rode-o ou aproxime-o da direita."
          }
        }
      }
    },
    "Makes a copy of the selection (⌘D)." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hace una copia de la selección (⌘D)."
          }
        },
        "fr" : {
