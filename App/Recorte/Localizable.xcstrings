          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taille des cercles imprimés que cherche la caméra de la machine. Doit correspondre à la taille de repère réglée sur la machine : 25 imprime des cercles de Ø 5 mm."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
