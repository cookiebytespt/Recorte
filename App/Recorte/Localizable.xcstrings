    "Printed on the Print & Cut sheet, never cut. Create a cut contour, or draw or import the cut lines on top of it." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se imprime en la hoja de Imprimir y cortar, nunca se corta. Cree un contorno de corte, o dibuje o importe las líneas de corte encima."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imprimée sur la feuille d’impression et découpe, jamais découpée. Créez un contour de découpe, ou dessinez ou importez les lignes de découpe par-dessus."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impressa na folha de Imprimir e Cortar, nunca cortada. Crie um contorno de corte, ou desenhe ou importe as linhas de corte por cima."
          }
