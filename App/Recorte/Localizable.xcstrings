            "value" : "Colocar as linhas de corte em"
          }
        }
      }
    },
    "Put the sheet in printed side up, **turned round so the arrow mark is at the front, on the right**." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coloque la hoja con la cara impresa hacia arriba, **girada para que la marca de la flecha quede delante, a la derecha**."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Insérez la feuille face imprimée vers le haut, **retournée pour que le repère de la flèche soit devant, à droite**."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coloque a folha com a face impressa para cima, **virada ao contrário para que a marca da seta fique à frente, à direita**."
          }
        }
      }
    },
    "Puts every setting back to its default." : {
      "localizations" : {
        "es" : {
