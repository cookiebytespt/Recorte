    },
    "**The blade was on the arrow mark** (front right) when you pressed Origin." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**La cuchilla estaba sobre la marca de la flecha** (delante, a la derecha) cuando pulsó Origin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**La lame était sur le repère de la flèche** (devant, à droite) quand vous avez appuyé sur Origin."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**A lâmina estava sobre a marca da seta** (à frente, à direita) quando premiu Origin."
          }
        }
      }
    },
    "**The marks are solid black**, not faded, and not under a pinch roller or tape." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Las marcas son de un negro intenso**, no están descoloridas ni bajo un rodillo de arrastre o cinta adhesiva."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Les repères sont bien noirs**, pas pâles, et ne sont pas sous un galet presseur ni sous du ruban adhésif."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**As marcas estão bem pretas**, não desbotadas, e não estão debaixo de um rolo de pressão ou de fita-cola."
          }
        }
      }
    },
    "**The sheet is straight**, printed side up, the arrow mark at the front right." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**La hoja está recta**, con la cara impresa hacia arriba y la marca de la flecha delante a la derecha."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**La feuille est droite**, face imprimée vers le haut, le repère de la flèche devant à droite."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**A folha está direita**, com a face impressa para cima e a marca da seta à frente, à direita."
          }
        }
      }
    },
    "**The sheet was printed at 100 %%** with mark size %lld (Ø %lld mm)." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "**The sheet was printed at 100 %%** with mark size %1$lld (Ø %2$lld mm)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**La hoja se imprimió al 100 %%** con el tamaño de marca %1$lld (Ø %2$lld mm)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**La feuille a été imprimée à 100 %%** avec la taille de repère %1$lld (Ø %2$lld mm)."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**A folha foi impressa a 100 %%** com o tamanho de marca %1$lld (Ø %2$lld mm)."
          }
        }
      }
    },
    "1 Print  ›  2 Cut" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 Imprimir  ›  2 Cortar"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 Imprimer  ›  2 Découper"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 Imprimir  ›  2 Cortar"
          }
        }
      }
    },
    "300 dpi is enough for most printers. 600 dpi for fine detail; the file is four times bigger." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "300 ppp bastan para la mayoría de las impresoras. 600 ppp para detalles finos; el archivo ocupa cuatro veces más."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "300 dpi suffisent pour la plupart des imprimantes. 600 dpi pour les détails fins ; le fichier est quatre fois plus lourd."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "300 dpi chega para a maioria das impressoras. 600 dpi para detalhes finos; o ficheiro fica quatro vezes maior."
          }
        }
      }
    },
    "About: " : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acerca de: "
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À propos : "
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sobre: "
          }
        }
      }
    },
    "Adds a PDF, Illustrator, PNG or JPEG file to be printed on the Print & Cut sheet. Printed images are never cut (⌥⌘I)." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade un archivo PDF, Illustrator, PNG o JPEG para imprimir en la hoja de Imprimir y cortar. Las imágenes impresas nunca se cortan (⌥⌘I)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute un fichier PDF, Illustrator, PNG ou JPEG à imprimer sur la feuille d’impression et découpe. Les images imprimées ne sont jamais découpées (⌥⌘I)."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adiciona um ficheiro PDF, Illustrator, PNG ou JPEG para imprimir na folha de Imprimir e Cortar. As imagens impressas nunca são cortadas (⌥⌘I)."
          }
        }
      }
    },
    "Adds an SVG, PDF, Illustrator or DXF file as cut lines (⇧⌘I)." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade un archivo SVG, PDF, Illustrator o DXF como líneas de corte (⇧⌘I)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute un fichier SVG, PDF, Illustrator ou DXF comme lignes de découpe (⇧⌘I)."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adiciona um ficheiro SVG, PDF, Illustrator ou DXF como linhas de corte (⇧⌘I)."
          }
        }
      }
    },
    "Adds the cut lines to the canvas as normal shapes you can still edit." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade las líneas de corte al lienzo como formas normales que puede seguir editando."
          }
