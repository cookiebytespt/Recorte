    "Machine units per millimetre. Leave it at 40 for the Liyu; a wrong value cuts everything at the wrong size." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unidades de la máquina por milímetro. Deje 40 para la Liyu; un valor erróneo corta todo con el tamaño equivocado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unités machine par millimètre. Laissez 40 pour la Liyu ; une mauvaise valeur découpe tout à la mauvaise taille."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unidades da máquina por milímetro. Deixe 40 para a Liyu; um valor errado corta tudo no tamanho errado."
          }
        }
      }
    },
    "Machine's own speed and pressure · %@" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
