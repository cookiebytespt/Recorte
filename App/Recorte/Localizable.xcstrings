        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clique para adicionar texto em qualquer tipo de letra instalado. É convertido em contornos para cortar."
          }
        }
      }
    },
    "Click to select, drag to move, Shift-click to add more. Double-click lines to edit their points." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haga clic para seleccionar, arrastre para mover, Mayús-clic para añadir más. Haga doble clic en las líneas para editar sus puntos."
