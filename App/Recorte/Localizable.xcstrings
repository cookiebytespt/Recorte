    "Gap between the artwork and the cut line. 2 mm hides small differences between the print and the cut. In SignMaster: Outline offset." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Separación entre la ilustración y la línea de corte. 2 mm disimulan pequeñas diferencias entre la impresión y el corte. En SignMaster: Outline offset."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Écart entre l’illustration et la ligne de découpe. 2 mm masquent les petits décalages entre l’impression et la découpe. Dans SignMaster : Outline offset."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espaço entre a arte e a linha de corte. 2 mm disfarçam pequenas diferenças entre a impressão e o corte. No SignMaster: Outline offset."
          }
        }
      }
    },
    "Gap between the artwork and the marks to its left and right. In SignMaster: Mark Position (20.5 mm)." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Separación entre la ilustración y las marcas a su izquierda y derecha. En SignMaster: Mark Position (20,5 mm)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Écart entre l’illustration et les repères à sa gauche et à sa droite. Dans SignMaster : Mark Position (20,5 mm)."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espaço entre a arte e as marcas à esquerda e à direita. No SignMaster: Mark Position (20,5 mm)."
          }
        }
      }
    },
    "Getting Started" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
