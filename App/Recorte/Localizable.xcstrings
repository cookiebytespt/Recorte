    "Load the vinyl so **its front edge is just past the blade**, then lower the pinch rollers." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cargue el vinilo de modo que **su borde delantero quede justo pasada la cuchilla** y baje los rodillos de arrastre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chargez le vinyle pour que **son bord avant dépasse juste la lame**, puis abaissez les galets presseurs."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coloque o vinil de modo que **a margem da frente fique logo a seguir à lâmina** e baixe os rolos de pressão."
          }
        }
      }
    },
    "Lock or unlock. Locked objects can't be moved, resized or deleted." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bloquear o desbloquear. Los objetos bloqueados no se pueden mover, redimensionar ni eliminar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verrouiller ou déverrouiller. Les objets verrouillés ne peuvent être ni déplacés, ni redimensionnés, ni supprimés."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bloquear ou desbloquear. Os objetos bloqueados não podem ser movidos, redimensionados nem apagados."
          }
        }
      }
    },
