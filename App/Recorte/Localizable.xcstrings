    "Removes all picked colours." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina todos los colores elegidos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime toutes les couleurs choisies."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apaga todas as cores escolhidas."
          }
        }
      }
    },
    "Removes cut contours made earlier for the same images, so they aren't cut twice." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina los contornos de corte hechos antes para las mismas imágenes, para que no se corten dos veces."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime les contours de découpe créés auparavant pour les mêmes images, pour ne pas découper deux fois."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apaga os contornos de corte feitos antes para as mesmas imagens, para não serem cortados duas vezes."
          }
        }
      }
    },
    "Removes the last colour you picked." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina el último color elegido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime la dernière couleur choisie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apaga a última cor escolhida."
          }
        }
      }
    },
    "Removes the lines inside other lines, such as holes in a cut contour" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina las líneas que están dentro de otras, como los huecos de un contorno de corte"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime les lignes situées dans d’autres lignes, comme les trous d’un contour de découpe"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remove as linhas dentro de outras linhas, como os buracos de um contorno de corte"
          }
        }
      }
    },
    "Removes the selection, except locked objects. Undo with ⌘Z." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina la selección, excepto los objetos bloqueados. Deshaga con ⌘Z."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime la sélection, sauf les objets verrouillés. Annulez avec ⌘Z."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apaga a seleção, exceto os objetos bloqueados. Anule com ⌘Z."
          }
        }
      }
    },
    "Removes the whole line that the selected point belongs to." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina toda la línea a la que pertenece el punto seleccionado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime toute la ligne à laquelle appartient le point sélectionné."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apaga a linha inteira a que pertence o ponto selecionado."
          }
        }
      }
    },
    "Reorders the shapes so the knife travels less between them. Doesn't change what is cut." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reordena las formas para que la cuchilla recorra menos entre ellas. No cambia lo que se corta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réordonne les formes pour que la lame se déplace moins entre elles. Ne change pas ce qui est découpé."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reordena as formas para a lâmina andar menos entre elas. Não muda o que é cortado."
          }
        }
      }
    },
    "Replace existing cut contours" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sustituir los contornos de corte existentes"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remplacer les contours de découpe existants"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Substituir contornos de corte existentes"
          }
        }
      }
    },
    "Replaces many small straight segments with fewer smooth curves. Good for traced or imported lines." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sustituye muchos segmentos rectos pequeños por menos curvas suaves. Útil para líneas trazadas o importadas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remplace de nombreux petits segments droits par moins de courbes lisses. Idéal pour les lignes tracées ou importées."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Troca muitos segmentos retos pequenos por menos curvas suaves. Bom para linhas traçadas ou importadas."
          }
        }
      }
    },
    "Report a Problem…" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Informar de un problema…"
          }
        },
        "fr" : {
