    "Drag to draw a straight line. Open lines are cut but don't make a separate piece." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastre para dibujar una línea recta. Las líneas abiertas se cortan, pero no forman una pieza separada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser pour tracer une ligne droite. Les lignes ouvertes sont découpées mais ne forment pas une pièce séparée."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arraste para desenhar uma linha reta. As linhas abertas são cortadas, mas não formam uma peça separada."
          }
        }
      }
    },
    "Drag to draw freely. Turn on Closed shape in the sidebar to cut out a piece." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastre para dibujar a mano alzada. Active Forma cerrada en la barra lateral para cortar una pieza."
          }
        },
        "fr" : {
          "stringUnit" : {
