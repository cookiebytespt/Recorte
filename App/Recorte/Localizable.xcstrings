    "Move the artwork away from the edges, use a bigger page or a smaller distance." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aleje la ilustración de los bordes, use una página más grande o una distancia menor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Éloignez l’illustration des bords, utilisez une page plus grande ou une distance plus petite."
          }
