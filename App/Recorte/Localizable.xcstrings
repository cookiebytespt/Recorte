          }
        }
      }
    },
    "Goes straight to cutting a sheet that is already printed." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasa directamente a cortar una hoja ya impresa."
          }
        },
        "fr" : {
          "stringUnit" : {
